# serializer version: 1
# name: test_help_snapshot[repo_ffwd completion]
  '''
  Usage: repo-ffwd completion [OPTIONS] {bash|zsh|fish}
  
    Print a shell completion script.
  
    Examples:     repo_ffwd completion bash >> ~/.bashrc     eval "$(repo_ffwd
    completion zsh)"
  
  Options:
    -h, --help  Show this message and exit.
  
  '''
# ---
# name: test_help_snapshot[repo_ffwd config get]
  '''
  Usage: repo-ffwd config get [OPTIONS] {defaults.depth|logging.file|logging.file_
                              level|logging.format|logging.level|output.color|outp
                              ut.format|output.only_changed|sync.autostash|sync.co
                              ncurrency|sync.include_worktrees|sync.prune|sync.rem
                              ote|sync.retries|sync.timeout_seconds|token}
  
    Show a resolved config value and where it came from.
  
    Examples:     repo-ffwd config get sync.concurrency     repo-ffwd config get
    output.color --json
  
  Options:
    -o, --output [text|json|markdown]
                                    Output format. [default: text]
    --json                          Shorthand for --output json.
    --output-file FILE              Write results to a file instead of stdout
                                    (format set by --output).
    -v, --verbose                   Increase log verbosity (-vv for debug).
    -q, --quiet                     Suppress non-essential stderr output.
    --log-level [debug|info|warning|error|critical]
                                    Explicit console log level (overrides -v/-q).
    --log-file TEXT                 Enable rotating file logging (PATH optional;
                                    default: XDG state).
    --no-color                      Disable colored output.
    --config FILE                   Path to a TOML config file (overrides layered
                                    discovery).
    --token TEXT                    Py Personal Access Token (overrides
                                    $REPO_FFWD_TOKEN). Never stored.
    --no-input                      Never prompt; fail instead (for scripts/CI).
    -h, --help                      Show this message and exit.
  
  '''
# ---
# name: test_help_snapshot[repo_ffwd config init]
  '''
  Usage: repo-ffwd config init [OPTIONS]
  
    Create or update the config file with guided prompts.
  
    Asks (on stderr, so stdout stays pipe-safe) for root directories and the most
    common sync settings, offering currently resolved values as defaults, then
    writes them to the TOML config file. Examples:
  
        repo-ffwd config init     repo-ffwd config init --root ~/projects --yes
        repo-ffwd config init --dry-run
  
  Options:
    --root TEXT                     Root directory to include in initial
                                    configuration (repeatable).
    --dry-run                       Show what would change; write nothing.
    -y, --yes                       Skip confirmation prompts (for scripts/CI).
    -o, --output [text|json|markdown]
                                    Output format. [default: text]
    --json                          Shorthand for --output json.
    --output-file FILE              Write results to a file instead of stdout
                                    (format set by --output).
    -v, --verbose                   Increase log verbosity (-vv for debug).
    -q, --quiet                     Suppress non-essential stderr output.
    --log-level [debug|info|warning|error|critical]
                                    Explicit console log level (overrides -v/-q).
    --log-file TEXT                 Enable rotating file logging (PATH optional;
                                    default: XDG state).
    --no-color                      Disable colored output.
    --config FILE                   Path to a TOML config file (overrides layered
                                    discovery).
    --token TEXT                    Py Personal Access Token (overrides
                                    $REPO_FFWD_TOKEN). Never stored.
    --no-input                      Never prompt; fail instead (for scripts/CI).
    -h, --help                      Show this message and exit.
  
  '''
# ---
