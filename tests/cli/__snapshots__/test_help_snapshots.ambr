# name: test_help_snapshot[repo_updater config]
  '''
  Usage: repo-updater config [OPTIONS] COMMAND [ARGS]...
  
    Inspect and edit CLI configuration.
  
  Options:
    -h, --help  Show this message and exit.
  
  Commands:
    get   Show a resolved config value and where it came from.
    init  Create or update the config file with guided prompts.
    path  Show the config file path and whether it exists.
    set   Write a non-secret config value to the TOML config file.
    view  Show the effective merged configuration.
  
  '''
# ---
# name: test_help_snapshot[repo_updater doctor]
  '''
  Usage: repo-updater doctor [OPTIONS]
  
    Diagnose configuration and environment.
  
    Reports Python/platform, the resolved config file, and token status. Exits
    non-zero if any check is an error (useful in CI). Honors -o/--json. --bundle
    widens the report into a redacted snapshot (version, settings, app env vars
    with secrets masked) safe to paste into a public issue.
  
  Options:
    --bundle                        Emit a redacted diagnostics bundle to attach
                                    to bug reports.
    -o, --output [text|json|markdown]
                                    Output format. [default: text]
    --json                          Shorthand for --output json.
    --output-file FILE              Write results to a file instead of stdout
                                    (format set by --output).
    -v, --verbose                   Increase log verbosity (-vv for debug).
    -q, --quiet                     Suppress non-essential stderr output.
    --log-level [debug|info|warning|error|critical]
                                    Explicit console log level (overrides -v/-q).
    --log-file TEXT                 Enable rotating file logging (PATH optional;
                                    default: XDG state).
    --no-color                      Disable colored output.
    --config FILE                   Path to a TOML config file (overrides layered
                                    discovery).
    --token TEXT                    Py Personal Access Token (overrides
                                    $REPO_UPDATER_TOKEN). Never stored.
    --no-input                      Never prompt; fail instead (for scripts/CI).
    -h, --help                      Show this message and exit.
  
  '''
# ---
# name: test_help_snapshot[repo_updater repo list]
  '''
  Usage: repo-updater repo list [OPTIONS]
  
    List discovered Git repositories without making network calls.
  
    Examples:     repo-updater repo list     repo-updater repo list --root
    ~/projects --max-depth 2 --json
  
  Options:
    --root TEXT                     Directory root to scan (repeatable; overrides
                                    configured roots).
    --max-depth INTEGER RANGE       Maximum directory traversal depth below each
                                    root.  [0<=x<=10]
    --tag TEXT                      Limit listing to configured roots carrying at
                                    least one matching tag.
    --include-worktrees / --no-include-worktrees
                                    Include linked Git worktrees (skipped by
                                    default).
    -o, --output [text|json|markdown]
                                    Output format. [default: text]
    --json                          Shorthand for --output json.
    --output-file FILE              Write results to a file instead of stdout
                                    (format set by --output).
    -v, --verbose                   Increase log verbosity (-vv for debug).
    -q, --quiet                     Suppress non-essential stderr output.
    --log-level [debug|info|warning|error|critical]
                                    Explicit console log level (overrides -v/-q).
    --log-file TEXT                 Enable rotating file logging (PATH optional;
                                    default: XDG state).
    --no-color                      Disable colored output.
    --config FILE                   Path to a TOML config file (overrides layered
                                    discovery).
    --token TEXT                    Py Personal Access Token (overrides
                                    $REPO_UPDATER_TOKEN). Never stored.
    --no-input                      Never prompt; fail instead (for scripts/CI).
    -h, --help                      Show this message and exit.
  
  '''
# ---
# name: test_help_snapshot[repo_updater repo status]
  '''
  Usage: repo-updater repo status [OPTIONS]
  
    Show read-only branch, dirty, and ahead/behind status across repositories.
  
    Examples:     repo-updater repo status     repo-updater repo status --fetch
    --json
  
  Options:
    --root TEXT                     Directory root to scan (repeatable; overrides
                                    configured roots).
    --max-depth INTEGER RANGE       Maximum directory traversal depth below each
                                    root.  [0<=x<=10]
    --tag TEXT                      Limit status to configured roots carrying at
                                    least one matching tag.
    --fetch / --no-fetch            Fetch remotes before computing ahead/behind
                                    counts (offline by default).
    --concurrency INTEGER RANGE     Maximum number of parallel workers.
                                    [1<=x<=64]
    --timeout INTEGER RANGE         Per-repository git fetch timeout in seconds
                                    (when --fetch is set).  [1<=x<=3600]
    --include-worktrees / --no-include-worktrees
                                    Include linked Git worktrees (skipped by
                                    default).
    -o, --output [text|json|markdown]
                                    Output format. [default: text]
    --json                          Shorthand for --output json.
    --output-file FILE              Write results to a file instead of stdout
                                    (format set by --output).
    -v, --verbose                   Increase log verbosity (-vv for debug).
    -q, --quiet                     Suppress non-essential stderr output.
    --log-level [debug|info|warning|error|critical]
                                    Explicit console log level (overrides -v/-q).
    --log-file TEXT                 Enable rotating file logging (PATH optional;
                                    default: XDG state).
    --no-color                      Disable colored output.
    --config FILE                   Path to a TOML config file (overrides layered
                                    discovery).
    --token TEXT                    Py Personal Access Token (overrides
                                    $REPO_UPDATER_TOKEN). Never stored.
    --no-input                      Never prompt; fail instead (for scripts/CI).
    -h, --help                      Show this message and exit.
  
  '''
# ---
# name: test_help_snapshot[repo_updater repo sync]
  '''
  Usage: repo-updater repo sync [OPTIONS]
  
    Fetch and fast-forward default branches across repositories in parallel.
  
    Examples:     repo-updater repo sync     repo-updater repo sync --root
    ~/projects --concurrency 8     repo-updater repo sync --dry-run --all
    repo-updater repo sync --autostash --json --no-input
  
  Options:
    --root TEXT                     Directory root to scan (repeatable; overrides
                                    configured roots).
    --max-depth INTEGER RANGE       Maximum directory traversal depth below each
                                    root.  [0<=x<=10]
    --concurrency INTEGER RANGE     Maximum number of repositories to fetch in
                                    parallel.  [1<=x<=64]
    --timeout INTEGER RANGE         Per-repository git fetch timeout in seconds.
                                    [1<=x<=3600]
    --retries INTEGER RANGE         Retry attempts for transient network errors.
                                    [0<=x<=5]
    --autostash / --no-autostash    Stash and restore local changes only when
                                    behind and blocked by dirty files.
    --prune / --no-prune            Prune deleted remote-tracking branches during
                                    fetch.
    --dry-run                       Fetch and compute the update plan without
                                    modifying any branch or tree.
    --only-changed / --all          Hide already up-to-date repositories in text
                                    output (use --all to show every repo).
    --tag TEXT                      Limit sync to configured roots carrying at
                                    least one matching tag.
    --include-worktrees / --no-include-worktrees
                                    Include linked Git worktrees (skipped by
                                    default).
    --fail-fast                     Stop scheduling remaining repositories after
                                    the first failure.
    -o, --output [text|json|markdown]
                                    Output format. [default: text]
    --json                          Shorthand for --output json.
    --output-file FILE              Write results to a file instead of stdout
                                    (format set by --output).
    -v, --verbose                   Increase log verbosity (-vv for debug).
    -q, --quiet                     Suppress non-essential stderr output.
    --log-level [debug|info|warning|error|critical]
                                    Explicit console log level (overrides -v/-q).
    --log-file TEXT                 Enable rotating file logging (PATH optional;
                                    default: XDG state).
    --no-color                      Disable colored output.
    --config FILE                   Path to a TOML config file (overrides layered
                                    discovery).
    --token TEXT                    Py Personal Access Token (overrides
                                    $REPO_UPDATER_TOKEN). Never stored.
    --no-input                      Never prompt; fail instead (for scripts/CI).
    -h, --help                      Show this message and exit.
  
  '''
# ---
# name: test_help_snapshot[repo_updater repo]
  '''
  Usage: repo-updater repo [OPTIONS] COMMAND [ARGS]...
  
    Discover, inspect, and sync local Git repositories.
  
  Options:
    -h, --help  Show this message and exit.
  
  Commands:
    list    List discovered Git repositories without making network calls.
    status  Show read-only branch, dirty, and ahead/behind status across...
    sync    Fetch and fast-forward default branches across repositories in...
  
  '''
# ---
# name: test_help_snapshot[repo_updater]
  '''
  Usage: repo-updater [OPTIONS] [COMMAND] [ARGS]...
  
    repo-updater — safe, parallel, config-driven Git repository updater.
  
    Commands follow a noun-verb shape, e.g. `repo-updater repo sync`. Every
    command supports -o/--output {text,json,markdown}, --json, -v/--verbose, --no-
    color, and --config. Results go to stdout; logs and errors go to stderr.
  
  Options:
    -V, --version  Show version, Python, and platform, then exit.
    -h, --help     Show this message and exit.
  
  Commands:
    completion  Print a shell completion script.
    config      Inspect and edit CLI configuration.
    doctor      Diagnose configuration and environment.
    repo        Discover, inspect, and sync local Git repositories.
  
  '''
# ---
